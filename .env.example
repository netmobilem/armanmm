# --- Runtime ---
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173

# --- Database: single SQLite file on a volume (no external database) ---
DATABASE_PATH=./data/vira.db

# --- Redis: fully optional. Without it the app uses an in-process event bus + memory cache ---
# REDIS_URL=redis://localhost:6379

# --- Worker: embedded in the API process by default; set "false" to run it standalone ---
# EMBED_WORKER=false

# --- Security (generate strong random values; never commit real secrets) ---
SESSION_SECRET=change-me-64-bytes-random
ENCRYPTION_KEY=change-me-32-bytes-hex

# --- First-boot owner (production bootstrap; unset afterwards). Password ≥ 12 chars. ---
# OWNER_USERNAME=owner
# OWNER_PASSWORD=change-me-strong-password

# --- Worker tuning (standalone mode) ---
WORKER_POLL_MS=5000
